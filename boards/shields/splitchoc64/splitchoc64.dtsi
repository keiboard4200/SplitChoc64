#include <dt-bindings/zmk/matrix_transform.h>
#include <zephyr/dt-bindings/gpio/gpio.h>
#include "splitchoc64-layouts.dtsi"

/ {
    kscan0: kscan0 {
        compatible = "zmk,kscan-gpio-matrix";
        diode-direction = "col2row";
        wakeup-source;

        /* Ver012 U1/U2:
         * ROW0=D3/P0.29
         * ROW1=D6/P1.11
         * ROW2=D7/P1.12
         * ROW3=D8/P1.13
         * ROW4=D9/P1.14
         */
        row-gpios
            = <&gpio0 29 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&gpio1 11 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&gpio1 12 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&gpio1 13 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&gpio1 14 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            ;
    };

    default_transform: keymap_transform0 {
        compatible = "zmk,matrix-transform";
        rows = <5>;
        columns = <14>;

        /* Key order is exactly the user KLE, left-to-right / top-to-bottom.
         * Global columns 0..5 are LEFT.
         * Global columns 6..13 are RIGHT (right overlay col-offset=6).
         */
        map = <
            RC(0,0) RC(0,1) RC(0,2) RC(0,3) RC(0,4) RC(0,5)
            RC(0,6) RC(0,7) RC(0,8) RC(0,9) RC(0,10) RC(0,11) RC(0,12) RC(0,13)

            RC(1,0) RC(1,1) RC(1,2) RC(1,3) RC(1,4) RC(1,5)
            RC(1,6) RC(1,7) RC(1,8) RC(1,9) RC(1,10) RC(1,11) RC(1,12) RC(1,13)

            RC(2,0) RC(2,1) RC(2,2) RC(2,3) RC(2,4) RC(2,5)
            RC(2,6) RC(2,7) RC(2,8) RC(2,9) RC(2,10) RC(2,11) RC(2,12)

            RC(3,0) RC(3,1) RC(3,2) RC(3,3) RC(3,4) RC(3,5)
            RC(3,6) RC(3,7) RC(3,8) RC(3,9) RC(3,10) RC(3,11)

            RC(4,0) RC(4,1) RC(4,2) RC(4,3) RC(4,4)
            RC(4,6) RC(4,7) RC(4,8) RC(4,9) RC(4,10) RC(4,11)
        >;
    };


    joy_toggle: joy_toggle {
        compatible = "splitchoc64,behavior-joy-config";
        #binding-cells = <0>;
        command = <0>;
        display-name = "JOY On/Off";
    };

    joy_angle_inc: joy_angle_inc {
        compatible = "splitchoc64,behavior-joy-config";
        #binding-cells = <0>;
        command = <1>;
        display-name = "JOY Angle +5 deg";
    };

    joy_angle_dec: joy_angle_dec {
        compatible = "splitchoc64,behavior-joy-config";
        #binding-cells = <0>;
        command = <2>;
        display-name = "JOY Angle -5 deg";
    };

    joy_speed_inc: joy_speed_inc {
        compatible = "splitchoc64,behavior-joy-config";
        #binding-cells = <0>;
        command = <3>;
        display-name = "JOY Max Speed +";
    };

    joy_speed_dec: joy_speed_dec {
        compatible = "splitchoc64,behavior-joy-config";
        #binding-cells = <0>;
        command = <4>;
        display-name = "JOY Max Speed -";
    };

    joy_reset: joy_reset {
        compatible = "splitchoc64,behavior-joy-config";
        #binding-cells = <0>;
        command = <5>;
        display-name = "JOY Reset Defaults";
    };

    chosen {
        zmk,kscan = &kscan0;
        zmk,physical-layout = &default_layout;
    };
};

&default_layout {
    transform = <&default_transform>;
    kscan = <&kscan0>;
};
