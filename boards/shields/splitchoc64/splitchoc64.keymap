#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>

/ {
    keymap {
        compatible = "zmk,keymap";

        lay0 {
            display-name = "Lay0";
            bindings = <
            &kp ESC &kp N1 &kp N2 &kp N3 &kp N4 &kp N5 &kp N6 &kp N7 &kp N8 &kp N9 &kp N0 &kp MINUS &kp EQUAL &kp BSPC
            &kp TAB &kp Q &kp W &kp E &kp R &kp T &kp Y &kp U &kp I &kp O &kp P &kp LBKT &kp RBKT &kp BSLH
            &kp CAPS &kp A &kp S &kp D &kp F &kp G &kp H &kp J &kp K &kp L &kp SEMI &kp SQT &kp ENTER
            &kp LSHIFT &kp Z &kp X &kp C &kp V &kp B &kp N &kp M &kp COMMA &kp DOT &kp FSLH &kp RSHIFT
            &kp LCTRL &kp LGUI &kp LALT &mo 1 &kp SPACE &kp SPACE &mo 2 &kp RALT &kp RGUI &kp K_MENU &kp RCTRL
            >;
        };

        lay1 {
            display-name = "Lay1";
            /*
             * Hold the left Fn key for a left-hand numpad and right-hand
             * mouse buttons/scroll controls.
             */
            bindings = <
            &kp KP_NUM &kp KP_SLASH &kp KP_MULTIPLY &kp KP_MINUS &kp KP_PLUS &trans &trans &trans &trans &trans &trans &trans &trans &trans
            &trans &kp KP_N7 &kp KP_N8 &kp KP_N9 &kp KP_PLUS &trans &mkp MB4 &msc SCRL_LEFT &msc SCRL_UP &msc SCRL_DOWN &msc SCRL_RIGHT &mkp MB5 &trans &trans
            &trans &kp KP_N4 &kp KP_N5 &kp KP_N6 &kp KP_ENTER &trans &trans &mkp LCLK &mkp MCLK &mkp RCLK &trans &trans &trans
            &trans &kp KP_N1 &kp KP_N2 &kp KP_N3 &kp KP_ENTER &trans &trans &trans &trans &trans &trans &trans
            &trans &kp KP_N0 &kp KP_DOT &trans &trans &mkp LCLK &trans &mkp RCLK &mkp MCLK &mkp MB4 &mkp MB5
            >;
        };

        lay2 {
            display-name = "Lay2";
            /*
             * Hold the right Fn key for F1-F12 and right-hand navigation.
             * I/J/K/L form an inverted-T arrow cluster.
             */
            bindings = <
            &trans &kp F1 &kp F2 &kp F3 &kp F4 &kp F5 &kp F6 &kp F7 &kp F8 &kp F9 &kp F10 &kp F11 &kp F12 &trans
            &trans &trans &trans &trans &trans &trans &trans &kp PG_UP &kp UP &kp PG_DN &trans &kp INS &kp DEL &trans
            &trans &trans &trans &trans &trans &trans &kp HOME &kp LEFT &kp DOWN &kp RIGHT &kp END &kp DEL &trans
            &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans
            &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans
            >;
        };

        lay3 {
            display-name = "Lay3";
            /*
             * Activated only while Lay1 and Lay2 are both active.
             * Bluetooth profile numbers shown to the user are 1..5,
             * while BT_SEL arguments are zero-based 0..4.
             */
            bindings = <
            &joy_toggle &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_SEL 3 &bt BT_SEL 4 &joy_angle_dec &joy_angle_inc &joy_speed_dec &joy_speed_inc &joy_reset &bt BT_PRV &bt BT_NXT &bt BT_CLR
            &out OUT_TOG &out OUT_USB &out OUT_BLE &trans &trans &trans &joy_deadzone_dec &joy_deadzone_inc &joy_min_speed_dec &joy_min_speed_inc &joy_curve_dec &joy_curve_inc &trans &trans
            &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans
            &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans
            &trans &trans &trans &trans &trans &trans &trans &trans &trans &studio_unlock &trans
            >;
        };
    };

    conditional_layers {
        compatible = "zmk,conditional-layers";

        lay3_when_both_fn_held {
            if-layers = <1 2>;
            then-layer = <3>;
        };
    };
};
