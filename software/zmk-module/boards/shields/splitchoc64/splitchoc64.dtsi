#include <dt-bindings/zmk/matrix_transform.h>
#include <zephyr/dt-bindings/gpio/gpio.h>
#include <zephyr/dt-bindings/pwm/pwm.h>
#include <zephyr/dt-bindings/pinctrl/nrf-pinctrl.h>
#include "splitchoc64-layouts.dtsi"

/ {
    kscan0: kscan0 {
        compatible = "zmk,kscan-gpio-matrix";
        diode-direction = "col2row";
        wakeup-source;

        /* Ver001 U1/U2 matrix rows:
         * ROW0=D3/P0.29
         * ROW1=D6/P1.11
         * ROW2=D7/P1.12
         * ROW3=D8/P1.13
         * ROW4=D9/P1.14
         */
        row-gpios
            = <&gpio0 29 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&gpio1 11 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&gpio1 12 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&gpio1 13 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&gpio1 14 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            ;
    };

    /*
     * Ver001 discrete status LED.
     * PCB net LED_CTRL is XIAO Plus D19 = nRF52840 P1.07.
     * This is intentionally independent from the switch backlight.
     */
    status_leds: status_leds {
        compatible = "gpio-leds";

        status_led: status_led_0 {
            gpios = <&gpio1 7 GPIO_ACTIVE_HIGH>;
            label = "SplitChoc64 Status";
        };
    };

    aliases {
        status-led = &status_led;
    };

    /*
     * Ver001 switch backlight.
     * PCB net BL_PWM is XIAO Plus D2 = nRF52840 P0.28.
     * All key LEDs share one PWM-controlled backlight channel.
     */
    backlight: pwmleds {
        compatible = "pwm-leds";

        pwm_led_0 {
            pwms = <&pwm0 0 PWM_USEC(1000) PWM_POLARITY_NORMAL>;
            label = "SplitChoc64 Key Backlight";
        };
    };

    default_transform: keymap_transform0 {
        compatible = "zmk,matrix-transform";
        rows = <5>;
        columns = <14>;

        /* Key order follows the SplitChoc64 physical layout.
         * Global columns 0..5 are LEFT.
         * Global columns 6..13 are RIGHT (right overlay col-offset=6).
         */
        map = <
            RC(0,0) RC(0,1) RC(0,2) RC(0,3) RC(0,4) RC(0,5)
            RC(0,6) RC(0,7) RC(0,8) RC(0,9) RC(0,10) RC(0,11) RC(0,12) RC(0,13)

            RC(1,0) RC(1,1) RC(1,2) RC(1,3) RC(1,4) RC(1,5)
            RC(1,6) RC(1,7) RC(1,8) RC(1,9) RC(1,10) RC(1,11) RC(1,12) RC(1,13)

            RC(2,0) RC(2,1) RC(2,2) RC(2,3) RC(2,4) RC(2,5)
            RC(2,6) RC(2,7) RC(2,8) RC(2,9) RC(2,10) RC(2,11) RC(2,12)

            RC(3,0) RC(3,1) RC(3,2) RC(3,3) RC(3,4) RC(3,5)
            RC(3,6) RC(3,7) RC(3,8) RC(3,9) RC(3,10) RC(3,11)

            RC(4,0) RC(4,1) RC(4,2) RC(4,3) RC(4,4)
            RC(4,6) RC(4,7) RC(4,8) RC(4,9) RC(4,10) RC(4,11)
        >;
    };

    chosen {
        zmk,kscan = &kscan0;
        zmk,physical-layout = &default_layout;
        zmk,backlight = &backlight;
    };
};

&pinctrl {
    splitchoc64_bl_pwm_default: splitchoc64_bl_pwm_default {
        group1 {
            psels = <NRF_PSEL(PWM_OUT0, 0, 28)>;
        };
    };

    splitchoc64_bl_pwm_sleep: splitchoc64_bl_pwm_sleep {
        group1 {
            psels = <NRF_PSEL(PWM_OUT0, 0, 28)>;
            low-power-enable;
        };
    };
};

&pwm0 {
    status = "okay";
    pinctrl-0 = <&splitchoc64_bl_pwm_default>;
    pinctrl-1 = <&splitchoc64_bl_pwm_sleep>;
    pinctrl-names = "default", "sleep";
};

&default_layout {
    transform = <&default_transform>;
    kscan = <&kscan0>;
};
