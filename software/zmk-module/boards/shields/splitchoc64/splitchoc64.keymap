#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/backlight.h>

/ {
    behaviors {
        numfn: numfn {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <250>;
            bindings = <&kp>, <&kp>;
        };

        mouse_exit_kp: mouse_exit_kp {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            wait-ms = <0>;
            tap-ms = <5>;
            bindings =
                <&to 0>,
                <&macro_param_1to1>,
                <&macro_press &kp MACRO_PLACEHOLDER>,
                <&macro_pause_for_release>,
                <&macro_param_1to1>,
                <&macro_release &kp MACRO_PLACEHOLDER>;
        };

        mouse_exit_mo: mouse_exit_mo {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            wait-ms = <0>;
            tap-ms = <5>;
            bindings =
                <&to 0>,
                <&macro_param_1to1>,
                <&macro_press &mo MACRO_PLACEHOLDER>,
                <&macro_pause_for_release>,
                <&macro_param_1to1>,
                <&macro_release &mo MACRO_PLACEHOLDER>;
        };

        safe_bt_clear: safe_bt_clear {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <350>;
            bindings = <&none>, <&bt BT_CLR>;
        };

        safe_bootloader: safe_bootloader {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <350>;
            bindings = <&none>, <&bootloader>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        lay0 {
            display-name = "Base";
            bindings = <
            &kp ESC &kp N1 &kp N2 &kp N3 &kp N4 &kp N5 &kp N6 &kp N7 &kp N8 &kp N9 &kp N0 &kp MINUS &kp EQUAL &kp BSPC
            &kp TAB &kp Q &kp W &kp E &kp R &kp T &kp Y &kp U &kp I &kp O &kp P &kp LBKT &kp RBKT &kp BSLH
            &kp CAPS &kp A &kp S &kp D &kp F &kp G &kp H &kp J &kp K &kp L &kp SEMI &kp SQT &kp ENTER
            &kp LSHIFT &kp Z &kp X &kp C &kp V &kp B &kp N &kp M &kp COMMA &kp DOT &kp FSLH &kp RSHIFT
            &kp LCTRL &kp LGUI &kp LALT &mo 1 &kp SPACE &kp SPACE &mo 2 &kp RALT &kp RGUI &kp K_MENU &kp RCTRL
            >;
        };

        lay1 {
            display-name = "Num/Nav";
            bindings = <
            &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans
            &kp BSPC &numfn F7 KP_N7 &numfn F8 KP_N8 &numfn F9 KP_N9 &kp FSLH &kp MINUS &trans &kp HOME &kp UP &kp END &kp PG_UP &kp PG_DN &kp INS &kp DEL
            &kp ENTER &numfn F4 KP_N4 &numfn F5 KP_N5 &numfn F6 KP_N6 &kp KP_MULTIPLY &kp KP_PLUS &trans &kp LEFT &kp DOWN &kp RIGHT &trans &trans &trans
            &tog 4 &numfn F1 KP_N1 &numfn F2 KP_N2 &numfn F3 KP_N3 &numfn F10 KP_N0 &kp KP_DOT &trans &trans &trans &trans &trans &trans
            &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans
            >;
        };

        lay2 {
            display-name = "Edit/Symbol";
            bindings = <
            &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &kp F11 &kp F12 &trans
            &trans &kp LS(N9) &kp LS(N0) &kp LBKT &kp RBKT &kp LS(LBKT) &trans &kp HOME &kp PG_UP &kp PG_DN &kp END &kp INS &kp DEL &trans
            &trans &kp LS(COMMA) &kp LS(DOT) &kp EQUAL &kp KP_PLUS &kp LS(RBKT) &trans &kp LC(LEFT) &kp LC(RIGHT) &kp BSPC &trans &trans &trans
            &trans &kp LS(MINUS) &kp MINUS &kp LS(BSLH) &kp BSLH &kp GRAVE &trans &trans &trans &trans &trans &trans
            &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans
            >;
        };

        lay3 {
            display-name = "Adjust/System";
            bindings = <
            &trans &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_SEL 3 &bt BT_SEL 4 &bl BL_TOG &bl BL_DEC &bl BL_INC &bl BL_CYCLE &trans &bt BT_PRV &bt BT_NXT &safe_bt_clear
            &out OUT_TOG &out OUT_USB &out OUT_BLE &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans
            &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans
            &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans
            &safe_bootloader &trans &trans &trans &trans &trans &trans &trans &trans &studio_unlock &safe_bootloader
            >;
        };

        lay4 {
            display-name = "Mouse";
            bindings = <
            &mouse_exit_kp ESC &mouse_exit_kp N1 &mouse_exit_kp N2 &mouse_exit_kp N3 &mouse_exit_kp N4 &mouse_exit_kp N5 &mouse_exit_kp N6 &mouse_exit_kp N7 &mouse_exit_kp N8 &mouse_exit_kp N9 &mouse_exit_kp N0 &mouse_exit_kp MINUS &mouse_exit_kp EQUAL &mouse_exit_kp BSPC
            &mouse_exit_kp TAB &mouse_exit_kp Q &mouse_exit_kp W &mouse_exit_kp E &mouse_exit_kp R &mouse_exit_kp T &mouse_exit_kp Y &mkp MB4 &mkp MB5 &mouse_exit_kp O &mouse_exit_kp P &mouse_exit_kp LBKT &mouse_exit_kp RBKT &mouse_exit_kp BSLH
            &mouse_exit_kp CAPS &mouse_exit_kp A &mouse_exit_kp S &mouse_exit_kp D &mouse_exit_kp F &mouse_exit_kp G &mouse_exit_kp H &mkp LCLK &mkp RCLK &mkp MCLK &mouse_exit_kp SEMI &mouse_exit_kp SQT &mouse_exit_kp ENTER
            &mouse_exit_kp LSHIFT &mouse_exit_kp Z &mouse_exit_kp X &mouse_exit_kp C &mouse_exit_kp V &mouse_exit_kp B &mouse_exit_kp N &none &mouse_exit_kp COMMA &mouse_exit_kp DOT &mouse_exit_kp FSLH &mouse_exit_kp RSHIFT
            &mouse_exit_kp LCTRL &mouse_exit_kp LGUI &mouse_exit_kp LALT &mouse_exit_mo 1 &mouse_exit_kp SPACE &mouse_exit_kp SPACE &mo 2 &mouse_exit_kp RALT &mouse_exit_kp RGUI &mouse_exit_kp K_MENU &mouse_exit_kp RCTRL
            >;
        };
    };

    conditional_layers {
        compatible = "zmk,conditional-layers";

        lay3_when_both_fn_held {
            if-layers = <1 2>;
            then-layer = <3>;
        };
    };
};
